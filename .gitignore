# ==========================================
# 1. Editors and operating-system files
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ==========================================
# 2. Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.venv/
venv/
env/

# ==========================================
# 3. Java
# ==========================================
bin/
*.class
*.jar
*.war
target/

# ==========================================
# 4. C/C++ and compiled binaries
# ==========================================
*.exe
*.o
*.obj
*.out
*.so
*.dll
*.dylib

# ==========================================
# 5. Generated data
# ==========================================
# Local data lake content
datalake/**
!datalake/.gitkeep

# All generated indexes and databases
datamarts/**
!datamarts/.gitkeep

# ==========================================
# 6. Local control state
# ==========================================
control/downloaded_books.txt
control/indexed_books.txt
control/failed_to_download_books.txt
!control/.gitkeep

# ==========================================
# 7. Generated benchmark results
# ==========================================
benchmarks/benchmark_results.json
benchmarks/metrics.csv
benchmarks/benchmark_comparison.png

# Temporary benchmark workspaces
benchmarks/.tmp/
benchmark_output/
benchmark_outputs/

# ==========================================
# 8. Temporary files
# ==========================================
*.tmp
*.temp
*.log
benchmarks/run_benchmarks_legacy.py
